@using PortfolioApp.Data.Entities
@model Testimonial

@{
    ViewData["Title"] = "Edit Testimonial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-stack-lg">
    <div>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface">
            Edit Testimonial
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Update the testimonial record.
        </p>
    </div>
    <a href="/Testimonial/Index"
       class="flex items-center gap-2 text-on-surface-variant hover:text-on-surface px-4 py-2.5 rounded-xl font-label-lg text-label-lg transition-all duration-200">
        <span class="material-symbols-outlined text-base">arrow_back</span>
        Back
    </a>
</div>

<div class="bg-surface-container rounded-xl border border-outline p-6 max-w-2xl">
    <form asp-action="Update" method="post" class="flex flex-col gap-stack-md">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
            <div>
                <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="FirstName">First Name</label>
                <input type="text" id="FirstName" name="FirstName" value="@Model.FirstName"
                       class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <div>
                <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="LastName">Last Name</label>
                <input type="text" id="LastName" name="LastName" value="@Model.LastName"
                       class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-stack-md">
            <div>
                <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="Initials">Initials</label>
                <input type="text" id="Initials" name="Initials" maxlength="3" value="@Model.Initials"
                       class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>

            <div>
                <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="Rating">Rating (1-5)</label>
                <input type="number" id="Rating" name="Rating" min="1" max="5" value="@Model.Rating"
                       class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
            </div>
        </div>

        <div>
            <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="Title">Title</label>
            <input type="text" id="Title" name="Title" value="@Model.Title"
                   class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary" />
        </div>

        <div>
            <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="Comment">Comment</label>
            <textarea id="Comment" name="Comment" rows="4"
                      class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary">@Model.Comment</textarea>
        </div>

        <div class="flex gap-3 justify-end mt-2">
            <a href="/Testimonial/Index"
               class="px-4 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-variant font-label-lg text-label-lg transition-all duration-200">
                Cancel
            </a>
            <button type="submit"
                    class="px-4 py-2.5 rounded-xl bg-primary-container text-on-primary-container hover:opacity-90 active:scale-95 font-label-lg text-label-lg transition-all duration-200">
                Save
            </button>
        </div>
    </form>
</div>
