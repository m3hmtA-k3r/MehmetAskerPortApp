@using PortfolioApp.Data.Entities
@model IEnumerable<UserMessage>

@{
    ViewData["Title"] = "Messages";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-stack-lg">
    <div>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface">
            Message Inbox
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Messages sent by visitors through the contact form.
        </p>
    </div>
    @if (ViewBag.UnreadCount > 0)
    {
        <span class="flex items-center gap-2 bg-primary-container/20 text-primary px-4 py-2 rounded-xl font-label-lg text-label-lg">
            <span class="material-symbols-outlined text-base">mark_email_unread</span>
            @ViewBag.UnreadCount unread
        </span>
    }
</div>

<div class="flex items-center gap-2 mb-stack-lg">
    <a href="/UserMessage/Index?filter=all"
       class="px-4 py-2 rounded-full font-label-lg text-label-lg transition-all duration-200 @(ViewBag.CurrentFilter == "all" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
        Tümü
    </a>
    <a href="/UserMessage/Index?filter=unread"
       class="px-4 py-2 rounded-full font-label-lg text-label-lg transition-all duration-200 @(ViewBag.CurrentFilter == "unread" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
        Okunmayanlar
    </a>
    <a href="/UserMessage/Index?filter=read"
       class="px-4 py-2 rounded-full font-label-lg text-label-lg transition-all duration-200 @(ViewBag.CurrentFilter == "read" ? "bg-primary-container text-on-primary-container" : "text-on-surface-variant hover:bg-surface-variant")">
        Okunanlar
    </a>
</div>

@await Component.InvokeAsync("_UserMessageTableList")

<div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60">
    <div class="bg-surface-container rounded-2xl border border-outline/30 shadow-2xl p-6 w-full max-w-sm mx-4">
        <div class="flex items-center gap-3 mb-4">
            <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-error/10">
                <span class="material-symbols-outlined text-error">warning</span>
            </div>
            <h3 class="font-title-md text-title-md text-on-surface">Delete</h3>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant mb-6">
            Delete the message from <span id="delete-name" class="text-on-surface font-medium"></span>?
            This action is irreversible.
        </p>
        <div class="flex gap-3 justify-end">
            <button onclick="closeDeleteModal()"
                    class="px-4 py-2 rounded-xl text-on-surface-variant hover:bg-surface-variant font-label-lg text-label-lg transition-all duration-200">
                Cancel
            </button>
            <form id="delete-form" method="post">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="px-4 py-2 rounded-xl bg-error text-white hover:brightness-110 active:scale-95 font-label-lg text-label-lg transition-all duration-200">
                    Yes, Delete
                </button>
            </form>

        </div>
    </div>
</div>

<!-- Details Modal -->
<div id="details-modal" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/60 pt-24">
    <div class="w-full max-w-3xl mx-4 relative">
        
        <button onclick="closeDetailsModal()"
                class="absolute -top-4 -right-4 flex items-center justify-center w-8 h-8 rounded-full bg-surface-container border border-outline text-on-surface-variant hover:text-on-surface">
            <span class="material-symbols-outlined text-lg">close</span>
        </button>
        <div id="details-modal-body">
            
        </div>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        document.getElementById('delete-name').textContent = name;
        document.getElementById('delete-form').action = '/UserMessage/Delete/' + id;
        const modal = document.getElementById('delete-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeDeleteModal() {
        const modal = document.getElementById('delete-modal');
        modal.classList.remove('flex');
        modal.classList.add('hidden');
    }

    async function openDetailsModal(id) {
        const res = await fetch('/UserMessage/Details/' + id);
        const html = await res.text();
        document.getElementById('details-modal-body').innerHTML = html;
        const modal = document.getElementById('details-modal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeDetailsModal() {
        const modal = document.getElementById('details-modal');
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        location.reload();
    }

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeDeleteModal();
            closeDetailsModal();
        }
    });
</script>
