@using PortfolioApp.Data.Entities
@model ProjectTechStack

@{
    ViewData["Title"] = "Project-TechStack Update";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="flex items-center justify-between mb-stack-lg">
    <div>
        <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface">
            Edit Project-TechStack Link
        </h1>
        <p class="font-body-md text-body-md text-on-surface-variant mt-1">
            Update this project-technology connection.
        </p>
    </div>
    <a href="/ProjectTechStack/Index"
       class="flex items-center gap-2 text-on-surface-variant hover:text-on-surface px-4 py-2.5 rounded-xl font-label-lg text-label-lg transition-all duration-200">
        <span cla
              public IActionResult Update(int id)
              {
              var techStack=_context.ProjectTechStacks.Find(id);
              ss="material-symbols-outlined text-base">arrow_back</span>
        Back
    </a>
</div>

<div class="bg-surface-container rounded-xl border border-outline p-6 max-w-2xl">
    <form asp-action="Update" method="post" class="flex flex-col gap-stack-md">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div>
            <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="ProjectId">Project</label>
            <select id="ProjectId" name="ProjectId"
                    class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary">
                @foreach (var project in (List<Project>)ViewBag.Projects)
                {
                    if (project.Id == Model.ProjectId)
                    {
                        <option value="@project.Id" selected>@project.Name</option>
                    }
                    else
                    {
                        <option value="@project.Id">@project.Name</option>
                    }
                }
            </select>
        </div>

        <div>
            <label class="block font-label-lg text-label-lg text-on-surface-variant mb-1.5" for="TechStackId">TechStack</label>
            <select id="TechStackId" name="TechStackId"
                    class="w-full bg-surface-container-low border border-outline rounded-xl px-4 py-2.5 text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary">
                @foreach (var techStack in (List<TechStack>)ViewBag.TechStacks)
                {
                    if (techStack.Id == Model.TechStackId)
                    {
                        <option value="@techStack.Id" selected>@techStack.Name</option>
                    }
                    else
                    {
                        <option value="@techStack.Id">@techStack.Name</option>
                    }
                }
            </select>
        </div>

        <div class="flex gap-3 justify-end mt-2">
            <a href="/ProjectTechStack/Index"
               class="px-4 py-2.5 rounded-xl text-on-surface-variant hover:bg-surface-variant font-label-lg text-label-lg transition-all duration-200">
                Cancel
            </a>
            <button type="submit"
                    class="px-4 py-2.5 rounded-xl bg-primary-container text-on-primary-container hover:opacity-90 active:scale-95 font-label-lg text-label-lg transition-all duration-200">
                Save
            </button>
        </div>
    </form>
</div>
