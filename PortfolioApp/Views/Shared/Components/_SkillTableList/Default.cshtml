@*
     _SkillTableList
*@

@using PortfolioApp.Data.Entities
@model IEnumerable<Skill>

<div class="bg-surface-container rounded-xl border border-outline overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-outline bg-surface-container-high">
                    <th class="text-left px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Name</th>
                    <th class="text-center px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Status</th>
                    <th class="text-center px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="border-b border-outline hover:bg-surface-container-high transition-colors duration-150">
                            <td class="px-4 py-3 font-body-md text-body-md text-on-surface font-medium">@item.Name</td>
                            <td class="px-4 py-3 text-center">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-success/10 text-success font-label-md text-label-md border border-success/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-success"></span>
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-error/10 text-error font-label-md text-label-md border border-error/20">
                                        <span class="w-1.5 h-1.5 rounded-full bg-error"></span>
                                        Passive
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center gap-2">
                                    <button onclick="openEditModal(@item.Id)"
                                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-secondary-container/20 text-secondary hover:bg-secondary-container/40 font-label-md text-label-md transition-all duration-200 active:scale-95">
                                        <span class="material-symbols-outlined text-base">edit</span>
                                        Update
                                    </button>
                                    <button onclick="confirmDelete(@item.Id, '@item.Name')"
                                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-error/10 text-error hover:bg-error/20 font-label-md text-label-md transition-all duration-200 active:scale-95">
                                        <span class="material-symbols-outlined text-base">delete</span>
                                        Del
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="px-4 py-16 text-center">
                            <span class="material-symbols-outlined text-5xl text-on-surface-variant block mb-2 opacity-40">inbox</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">No registration yet.</p>
                            <a href="/Skill/Create" class="mt-4 inline-flex items-center gap-1.5 text-primary font-label-lg text-label-lg hover:underline">
                                <span class="material-symbols-outlined text-base">add</span>
                                New Add
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="px-4 py-3 border-t border-outline/20 bg-surface-container-low">
            <span class="font-label-md text-label-md text-on-surface-variant">
                Total of <span class="text-on-surface font-medium">@Model.Count()</span> record
            </span>
        </div>
    }
</div>