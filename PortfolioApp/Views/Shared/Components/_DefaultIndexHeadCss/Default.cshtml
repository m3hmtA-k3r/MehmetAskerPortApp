@*
    _DefaultIndexHeadCss
*@


<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mehmet Asker | Yazılım Geliştirici</title>
    @* Tek dış bağımlılık: Service.Icon alanındaki Material Symbols ikon adları için (admin panelde de aynı font kullanılıyor) *@
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #0e1210; /* yeşile çalan koyu zemin */
            --bg-raise: #131816; /* hover/yüzey tonu */
            --card: #141a17; /* kart zemini */
            --ink: #eceae2; /* ana metin */
            --ink-soft: #b3b8ac; /* ikincil metin */
            --ink-faint: #7d857c; /* soluk metin */
            --line: #26302a; /* çizgiler */
            --brass: #d9a441; /* pirinç vurgu */
            --brass-soft: #b78629;
            --moss: #7a8b6f; /* yosun yeşili (ikincil vurgu) */
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *, *::before, *::after {
                animation: none !important;
                transition: none !important;
            }
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
            font-size: 17px;
            line-height: 1.65;
            -webkit-font-smoothing: antialiased;
        }

        .serif {
            font-family: Georgia, "Times New Roman", serif;
        }

        .mono {
            font-family: Consolas, "Cascadia Mono", monospace;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: var(--brass);
        }

        a {
            color: inherit;
        }

            a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
                outline: 2px solid var(--brass);
                outline-offset: 3px;
            }

        .wrap {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ---------- Nav ---------- */
        nav.topnav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 40;
            backdrop-filter: blur(10px);
            background: rgba(14, 18, 16, 0.82);
            border-bottom: 1px solid var(--line);
        }

        .nav-inner {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 24px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            font-family: Georgia, serif;
            font-size: 1.15rem;
            text-decoration: none;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

            .brand em {
                font-style: normal;
                color: var(--brass);
            }

        .nav-links {
            display: flex;
            gap: 26px;
            align-items: center;
        }

            .nav-links a {
                text-decoration: none;
                font-size: 0.85rem;
                color: var(--ink-soft);
                transition: color 0.25s;
            }

                .nav-links a:hover {
                    color: var(--brass);
                }

        @@media (max-width: 800px) {
            .nav-links {
                display: none;
            }
        }

        /* ---------- Hero ---------- */
        .hero {
            position: relative;
            min-height: 92vh;
            display: flex;
            align-items: center;
            overflow: hidden;
            border-bottom: 1px solid var(--line);
        }

        #net {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
        }

        .hero-veil {
            position: absolute;
            inset: 0;
            background: linear-gradient(100deg, var(--bg) 30%, rgba(14,18,16,0.45) 70%, transparent);
        }

        .hero-inner {
            position: relative;
            z-index: 2;
            padding-top: 96px;
            padding-bottom: 64px;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: clamp(2.3rem, 5.6vw, 4.2rem);
            line-height: 1.12;
            font-weight: 400;
            letter-spacing: -0.015em;
            max-width: 16ch;
            text-wrap: balance;
        }

            .hero h1 em {
                font-style: italic;
                color: var(--brass);
            }

        .hero p.lede {
            margin-top: 24px;
            max-width: 48ch;
            color: var(--ink-soft);
            font-size: 1.08rem;
        }

        .hero .mono {
            display: block;
            margin-bottom: 20px;
        }

        .cta-row {
            margin-top: 36px;
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 13px 26px;
            font-size: 0.85rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-decoration: none;
            border-radius: 2px;
            border: none;
            cursor: pointer;
            transition: transform 0.2s, background 0.25s, color 0.25s;
        }

            .btn:active {
                transform: scale(0.97);
            }

        .btn-solid {
            background: var(--brass);
            color: var(--bg);
            font-weight: 600;
        }

            .btn-solid:hover {
                background: var(--brass-soft);
            }

        .btn-ghost {
            border: 1px solid var(--line);
            color: var(--ink);
            background: transparent;
        }

            .btn-ghost:hover {
                border-color: var(--brass);
                color: var(--brass);
            }

        /* ---------- Ortak bölüm ---------- */
        section.block {
            padding: 96px 0;
        }

        .sec-head {
            margin-bottom: 48px;
        }

            .sec-head h2 {
                font-family: Georgia, serif;
                font-weight: 400;
                font-size: clamp(1.7rem, 3.4vw, 2.4rem);
                margin-top: 10px;
                letter-spacing: -0.01em;
            }

            .sec-head p {
                color: var(--ink-soft);
                margin-top: 10px;
                max-width: 60ch;
            }

        /* ---------- Hakkımda ---------- */
        .about-grid {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 56px;
            align-items: center;
        }

        .about-photo {
            width: 100%;
            aspect-ratio: 4/5;
            object-fit: cover;
            border-radius: 2px;
            border: 1px solid var(--line);
            filter: saturate(0.85);
        }

        .about-text h2 {
            font-family: Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.7rem, 3.4vw, 2.4rem);
            margin: 10px 0 18px;
        }

        .about-text p {
            color: var(--ink-soft);
        }

        .skill-row {
            margin-top: 28px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .chip {
            font-family: Consolas, monospace;
            font-size: 0.72rem;
            letter-spacing: 0.08em;
            color: var(--ink-soft);
            border: 1px solid var(--line);
            padding: 6px 14px;
            border-radius: 2px;
            transition: border-color 0.25s, color 0.25s;
        }

            .chip:hover {
                border-color: var(--brass);
                color: var(--brass);
            }

        @@media (max-width: 820px) {
            .about-grid {
                grid-template-columns: 1fr;
                gap: 32px;
            }
        }

        /* ---------- Özgeçmiş ---------- */
        .resume-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 56px;
        }

        .resume-col h3 {
            font-family: Georgia, serif;
            font-weight: 400;
            font-size: 1.35rem;
            margin-bottom: 28px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--line);
        }

        .tl {
            position: relative;
            padding-left: 24px;
            border-left: 1px solid var(--line);
            display: flex;
            flex-direction: column;
            gap: 34px;
        }

        .tl-item {
            position: relative;
        }

            .tl-item::before {
                content: "";
                position: absolute;
                left: -29px;
                top: 7px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: var(--brass);
            }

            .tl-item h4 {
                font-family: Georgia, serif;
                font-weight: 400;
                font-size: 1.1rem;
            }

            .tl-item .meta {
                font-family: Consolas, monospace;
                font-size: 0.72rem;
                letter-spacing: 0.08em;
                color: var(--moss);
                margin: 6px 0 8px;
                text-transform: uppercase;
            }

            .tl-item p {
                color: var(--ink-soft);
                font-size: 0.94rem;
            }

        @@media (max-width: 820px) {
            .resume-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- Hizmetler ---------- */
        .svc-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 26px;
        }

        .svc {
            background: var(--card);
            border: 1px solid var(--line);
            padding: 34px 30px;
            border-radius: 2px;
            transition: border-color 0.3s, transform 0.3s;
        }

            .svc:hover {
                border-color: var(--brass);
                transform: translateY(-4px);
            }

            .svc .material-symbols-outlined {
                font-size: 2rem;
                color: var(--brass);
            }

            .svc h3 {
                font-family: Georgia, serif;
                font-weight: 400;
                font-size: 1.25rem;
                margin: 16px 0 10px;
            }

            .svc p {
                color: var(--ink-soft);
                font-size: 0.94rem;
            }

        @@media (max-width: 820px) {
            .svc-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- Projeler ---------- */
        .proj-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 26px;
        }

        .proj-card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 2px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: border-color 0.3s, transform 0.3s;
        }

            .proj-card:hover {
                border-color: var(--brass);
                transform: translateY(-4px);
            }

            .proj-card img {
                width: 100%;
                aspect-ratio: 16/9;
                object-fit: cover;
                border-bottom: 1px solid var(--line);
                filter: saturate(0.85);
            }

        .proj-body {
            padding: 26px 28px 30px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            flex-grow: 1;
        }

            .proj-body h3 {
                font-family: Georgia, serif;
                font-weight: 400;
                font-size: 1.4rem;
            }

            .proj-body p {
                color: var(--ink-soft);
                font-size: 0.95rem;
                flex-grow: 1;
            }

        .proj-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .proj-link {
            margin-top: 6px;
            align-self: flex-start;
            font-family: Consolas, monospace;
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--brass);
            border-bottom: 1px solid var(--brass);
            padding-bottom: 3px;
        }

            .proj-link:hover {
                color: var(--brass-soft);
            }

        @@media (max-width: 820px) {
            .proj-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- Referanslar ---------- */
        .testi-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 26px;
        }

        .testi {
            background: var(--card);
            border: 1px solid var(--line);
            padding: 30px 28px;
            border-radius: 2px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .stars {
            color: var(--brass);
            letter-spacing: 3px;
            font-size: 0.95rem;
        }

        .testi blockquote {
            color: var(--ink-soft);
            font-size: 0.95rem;
            font-style: italic;
            flex-grow: 1;
        }

        .testi-person {
            display: flex;
            align-items: center;
            gap: 12px;
            border-top: 1px solid var(--line);
            padding-top: 16px;
        }

        .avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--bg-raise);
            border: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Georgia, serif;
            color: var(--brass);
            font-size: 0.9rem;
        }

        .testi-person strong {
            font-size: 0.9rem;
            font-weight: 600;
            display: block;
        }

        .testi-person span {
            font-size: 0.78rem;
            color: var(--ink-faint);
        }

        @@media (max-width: 820px) {
            .testi-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- İletişim ---------- */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 56px;
        }

        .contact-info h2 {
            font-family: Georgia, serif;
            font-weight: 400;
            font-size: clamp(1.7rem, 3.4vw, 2.4rem);
            margin: 10px 0 18px;
        }

            .contact-info h2 em {
                font-style: italic;
                color: var(--brass);
            }

        .contact-info p {
            color: var(--ink-soft);
            max-width: 40ch;
        }

        .info-list {
            margin-top: 30px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

            .info-list a, .info-list span {
                font-family: Consolas, monospace;
                font-size: 0.85rem;
                color: var(--ink-soft);
                text-decoration: none;
            }

                .info-list a:hover {
                    color: var(--brass);
                }

        .form-stack {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

            .form-stack label {
                font-size: 0.8rem;
                color: var(--ink-faint);
                display: block;
                margin-bottom: 6px;
            }

            .form-stack input, .form-stack textarea {
                width: 100%;
                background: var(--bg-raise);
                border: 1px solid var(--line);
                color: var(--ink);
                padding: 13px 16px;
                border-radius: 2px;
                font-family: inherit;
                font-size: 0.95rem;
                transition: border-color 0.25s;
            }

                .form-stack input:focus, .form-stack textarea:focus {
                    border-color: var(--brass);
                    outline: none;
                }

            .form-stack textarea {
                min-height: 140px;
                resize: vertical;
            }

        @@media (max-width: 820px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ---------- Bildirim (toast) ---------- */
        .toast {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 60;
            padding: 14px 26px;
            border-radius: 2px;
            font-size: 0.9rem;
            border: 1px solid;
            animation: toast-out 0.5s ease 4s forwards;
        }

        .toast-success {
            background: #16211a;
            border-color: var(--moss);
            color: var(--ink);
        }

        .toast-error {
            background: #241614;
            border-color: #a85445;
            color: var(--ink);
        }

        @@keyframes toast-out {
            to {
                opacity: 0;
                visibility: hidden;
            }
        }

        /* ---------- Footer ---------- */
        footer.site-footer {
            border-top: 1px solid var(--line);
            padding: 34px 0;
            margin-top: 96px;
        }

        .foot-inner {
            max-width: 1080px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            color: var(--ink-faint);
            font-size: 0.82rem;
        }
        /* ---------- Scroll reveal ---------- */
        .reveal {
            opacity: 0;
            transform: translateY(18px);
            transition: opacity 0.7s ease, transform 0.7s ease;
        }

            .reveal.in {
                opacity: 1;
                transform: none;
            }

        @@media (prefers-reduced-motion: reduce) {
            .reveal {
                opacity: 1;
                transform: none;
                transition: none;
            }
        }

        .hero-photo {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #d9a441;
            margin: 18px 0 24px;
            display: block;
        }

    </style>
</head>
