                            "on-background": "#e5e2e1",
                            "on-tertiary-container": "#f2fbff",
                            "surface-variant": "#3D3D3D",
                            "tertiary-fixed-dim": "#bfc8cc",
                            "on-tertiary-fixed": "#141d20",
                            "on-secondary-fixed": "#001e30",
                            "tertiary": "#bfc8cc",
                            "surface-container": "#201f1f",
                            "surface": "#1E1E1E",
                            "background": "#131313",
                            "surface-dim": "#131313",
                            "on-error-container": "#ffdad6",
                            "on-primary": "#370096",
                            "error": "#FF5252",
                            "on-primary-fixed": "#20005f",
                            "secondary-fixed": "#cae6ff",
                            "surface-container-high": "#2a2a2a",
                            "on-secondary-container": "#003f5f",
                            "on-surface-variant": "#cac3d8",
                            "surface-container-lowest": "#0e0e0e",
                            "on-secondary-fixed-variant": "#004b70",
                            "tertiary-fixed": "#dbe4e8",
                            "on-tertiary-fixed-variant": "#3f484c",
                            "primary-container": "#7c4dff",
                            "inverse-on-surface": "#313030",
                            "on-tertiary": "#293235",
                            "surface-container-highest": "#353534",
                            "on-primary-fixed-variant": "#4f00d0",
                            "outline": "#444444",
                            "primary-fixed-dim": "#cdbdff",
                            "secondary-container": "#00affe",
                            "on-secondary": "#00344f",
                            "primary": "#cdbdff",
                            "secondary": "#8dcdff",
                            "outline-variant": "#494455",
                            "on-surface": "#e5e2e1",
                            "surface-container-low": "#1c1b1b",
                            "secondary-fixed-dim": "#8dcdff",
                            "error-container": "#93000a",
                            "surface-tint": "#cdbdff",
                            "inverse-primary": "#6833ea",
                            "surface-bright": "#393939",
                            "success": "#00E676",
                            "tertiary-container": "#6b7478",
                            "on-error": "#690005"
                    },
                    "borderRadius": {
                            "DEFAULT": "0.25rem",
                            "lg": "0.5rem",
                            "xl": "0.75rem",
                            "full": "9999px"
                    },
                    "spacing": {
                            "sidebar-width": "280px",
                            "sidebar-collapsed": "80px",
                            "margin-desktop": "32px",
                            "stack-md": "16px",
                            "stack-lg": "24px",
                            "stack-sm": "8px",
                            "margin-mobile": "16px",
                            "gutter": "24px"
                    },
                    "fontFamily": {
                            "headline-lg": ["Inter"],
                            "title-md": ["Inter"],
                            "display-lg": ["Inter"],
                            "body-lg": ["Inter"],
                            "label-lg": ["Inter"],
                            "body-md": ["Inter"],
                            "label-md": ["Inter"],
                            "headline-lg-mobile": ["Inter"],
                            "title-lg": ["Inter"]
                    },
                    "fontSize": {
                            "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                            "title-md": ["16px", { "lineHeight": "24px", "letterSpacing": "0.15px", "fontWeight": "500" }],
                            "display-lg": ["57px", { "lineHeight": "64px", "letterSpacing": "-0.25px", "fontWeight": "700" }],
                            "body-lg": ["16px", { "lineHeight": "24px", "letterSpacing": "0.5px", "fontWeight": "400" }],
