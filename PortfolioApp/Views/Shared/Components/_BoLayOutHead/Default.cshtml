                }
            }
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

            .material-symbols-outlined.fill {
                font-variation-settings: 'FILL' 1;
            }

        /* Drawer Transition */
        #navigation-drawer {
            transition: transform 0.3s ease-in-out;
        }

        .drawer-open #navigation-drawer {
            transform: translateX(0);
        }

        .drawer-closed #navigation-drawer {
            transform: translateX(-100%);
        }

        @@media (min-width: 768px) {
            .drawer-closed #navigation-drawer {
                transform: translateX(0); /* Always open on desktop */
            }
        }

        /* Backdrop Transition */
        #drawer-backdrop {
            transition: opacity 0.3s ease-in-out;
        }

        .drawer-open #drawer-backdrop {
            opacity: 1;
            pointer-events: auto;
        }

        .drawer-closed #drawer-backdrop {
            opacity: 0;
            pointer-events: none;
        }
    </style>
    <style>
        :root {
            --color-primary: 205 189 255;
            --color-primary-container: 124 77 255;
            --color-on-primary-container: 252 246 255;
        }
    </style>

    <style>
        body {
            min-height: max(884px, 100dvh);
        }
    </style>

</head>