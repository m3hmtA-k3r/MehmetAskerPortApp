@*
    _UserMessageTableList
*@

@using PortfolioApp.Data.Entities
@model IEnumerable<UserMessage>


<div class="bg-surface-container rounded-xl border border-outline overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full">
            <thead>
                <tr class="border-b border-outline bg-surface-container-high">
                    <th class="text-left px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Status</th>
                    <th class="text-left px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">From</th>
                    <th class="text-left px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Email</th>
                    <th class="text-left px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Message</th>
                    <th class="text-center px-4 py-3 font-label-lg text-label-lg text-on-surface-variant uppercase tracking-wider">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="border-b border-outline hover:bg-surface-container-high transition-colors duration-150 @(item.IsRead ? "" : "bg-primary-container/5")">
                            <td class="px-4 py-3">
                                @if (item.IsRead)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-variant text-on-surface-variant font-label-md text-label-md">
                                        <span class="material-symbols-outlined text-sm">drafts</span>
                                        Read
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-container/20 text-primary font-label-md text-label-md">
                                        <span class="material-symbols-outlined text-sm">mark_email_unread</span>
                                        New
                                    </span>
                                }
                            </td>

                            <td class="px-4 py-3 font-body-md text-body-md text-on-surface @(item.IsRead ? "" : "font-medium")">
                                <button onclick="openDetailsModal(@item.Id)" class="hover:text-primary hover:underline">
                                    @item.Name
                                </button>
                            </td>


                            <td class="px-4 py-3 font-body-md text-body-md text-on-surface-variant">
                                <a href="mailto:@item.Email" class="hover:text-primary hover:underline">@item.Email</a>
                            </td>
                            <td class="px-4 py-3 font-body-md text-body-md text-on-surface-variant max-w-md">
                                <span class="line-clamp-2">@item.MessageBody</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center gap-2">
                                    <button onclick="openDetailsModal(@item.Id)"
                                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-secondary-container/20 text-secondary hover:bg-secondary-container/40 font-label-md text-label-md transition-all duration-200 active:scale-95">
                                        <span class="material-symbols-outlined text-base">visibility</span>
                                        View
                                    </button>

                                    <button onclick="confirmDelete(@item.Id, '@item.Name')"
                                            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-error/10 text-error hover:bg-error/20 font-label-md text-label-md transition-all duration-200 active:scale-95">
                                        <span class="material-symbols-outlined text-base">delete</span>
                                        Del
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-4 py-16 text-center">
                            <span class="material-symbols-outlined text-5xl text-on-surface-variant block mb-2 opacity-40">inbox</span>
                            <p class="font-body-md text-body-md text-on-surface-variant">No messages yet.</p>
                            <p class="font-label-md text-label-md text-on-surface-variant mt-1 opacity-70">
                                Messages sent through the site's contact form will appear here.
                            </p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="px-4 py-3 border-t border-outline/20 bg-surface-container-low">
            <span class="font-label-md text-label-md text-on-surface-variant">
                Total of <span class="text-on-surface font-medium">@Model.Count()</span> message,
                <span class="text-primary font-medium">@Model.Count(m => !m.IsRead)</span> unread
            </span>
        </div>
    }
</div>
