@*
    _DefaultScript
*@


<script>
    (function () {
        // Scroll reveal: bölümler görünüme girince yumuşakça belirir
        var els = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
                });
            }, { threshold: 0.12 });
            els.forEach(function (el) { io.observe(el); });
        } else {
            els.forEach(function (el) { el.classList.add('in'); });
        }

        // Büyüyen sistem ağı — hero'nun imza animasyonu
        var canvas = document.getElementById('net');
        var ctx = canvas.getContext('2d');
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var nodes = [], links = [], W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
        var NODE_COLOR = 'rgba(217, 164, 65, 0.9)';   // pirinç
        var LINK_COLOR = 'rgba(122, 139, 111, 0.35)'; // yosun

        function resize() {
            var r = canvas.getBoundingClientRect();
            W = r.width; H = r.height;
            canvas.width = W * dpr; canvas.height = H * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function seed() {
            nodes = []; links = [];
            var rootX = W * 0.78, rootY = H * 0.5;
            nodes.push({ x: rootX, y: rootY, r: 4.5, born: 0 });
            var count = Math.max(26, Math.min(54, Math.floor(W / 26)));
            for (var i = 1; i < count; i++) {
                var parent = nodes[Math.floor(Math.pow(Math.random(), 1.6) * nodes.length)];
                var ang = Math.random() * Math.PI * 2;
                var dist = 55 + Math.random() * 95;
                var nx = parent.x + Math.cos(ang) * dist;
                var ny = parent.y + Math.sin(ang) * dist * 0.85;
                nx = Math.max(W * 0.38, Math.min(W - 20, nx));
                ny = Math.max(20, Math.min(H - 20, ny));
                var n = { x: nx, y: ny, r: 1.6 + Math.random() * 2.6, born: i * 140 };
                nodes.push(n);
                links.push({ a: parent, b: n, born: i * 140 });
            }
        }

        var start = null;
        function draw(now) {
            if (start === null) start = now;
            var t = reduced ? 1e9 : now - start;
            ctx.clearRect(0, 0, W, H);

            ctx.strokeStyle = LINK_COLOR; ctx.lineWidth = 1;
            links.forEach(function (l) {
                var p = Math.max(0, Math.min(1, (t - l.born) / 700));
                if (p <= 0) return;
                ctx.beginPath();
                ctx.moveTo(l.a.x, l.a.y);
                ctx.lineTo(l.a.x + (l.b.x - l.a.x) * p, l.a.y + (l.b.y - l.a.y) * p);
                ctx.stroke();
            });

            ctx.fillStyle = NODE_COLOR;
            var pulse = reduced ? 0 : Math.sin(now / 900) * 0.6;
            nodes.forEach(function (n, i) {
                var p = Math.max(0, Math.min(1, (t - n.born) / 500));
                if (p <= 0) return;
                ctx.beginPath();
                ctx.arc(n.x, n.y, (n.r + (i === 0 ? pulse : 0)) * p, 0, Math.PI * 2);
                ctx.fill();
            });

            if (!reduced) requestAnimationFrame(draw);
        }

        function init() { resize(); seed(); start = null; requestAnimationFrame(draw); }
        var rt;
        window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(init, 200); });
        init();
    })();
</script>